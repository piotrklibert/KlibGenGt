{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klibgen.local/schemas/v2/resolved-recipe.schema.json",
  "title": "KlibGen resolved recipe v1",
  "type": "object",
  "required": ["schema", "schemaVersion", "operation", "target", "recipe", "preset", "steps", "outputKey"],
  "properties": {
    "schema": {"const": "klibgen.resolved-recipe/1"},
    "schemaVersion": {"const": 1},
    "operation": {"const": "v2.recipe.resolve"},
    "target": {"type": "string"},
    "recipe": {"type": "string"},
    "preset": {"type": "object"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "implementation", "implementationInputs", "resolvedConfiguration", "parentOutputKey", "stepKey", "outputKey", "checkpoint", "origin"],
        "properties": {
          "role": {"type": "string"},
          "implementation": {"type": "object"},
          "implementationInputs": {"type": "object"},
          "resolvedConfiguration": {"type": "object"},
          "parentOutputKey": {"type": ["string", "null"]},
          "stepKey": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "outputKey": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "checkpoint": {"enum": ["none", "artifact"]},
          "origin": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "outputKey": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
